# ============================================================
#  Telegram group management SaaS platform - env example
#  Copy to .env then edit:  cp .env.example .env
# ============================================================

# ---------- general ----------
NODE_ENV=development

# Public URL of the platform (Telegram webhook needs an HTTPS public URL).
# For local dev expose via ngrok/cloudflared: https://xxxx.ngrok-free.app
PUBLIC_URL=http://localhost

# ---------- PostgreSQL ----------
POSTGRES_USER=tgadmin
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=tg_saas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tgadmin:change_me_postgres@postgres:5432/tg_saas?schema=public

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---------- backend API ----------
API_PORT=4000
JWT_SECRET=change_me_jwt_secret_please_use_long_random_string
JWT_EXPIRES_IN=7d
TELEGRAM_WEBHOOK_SECRET=change_me_webhook_secret

# ---------- platform bot (auto-connects on startup) ----------
# Paste the token from @BotFather here. Leave empty to disable the default bot
# (you can still add bots from the dashboard).
BOT_TOKEN=
# Optional, informational (e.g. my_group_bot). Used as the bot display name.
BOT_USERNAME=
# Public HTTPS base URL for Telegram webhooks, e.g. https://xxxx.ngrok-free.app
# The platform appends /webhook/<botId> automatically.
# If left EMPTY, the bot connects via long polling (works locally without HTTPS).
WEBHOOK_URL=

# ---------- frontend ----------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost/api

# ---------- third-party verification (placeholders for now) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---------- AI risk control (placeholder) ----------
AI_RISK_PROVIDER=stub
AI_RISK_API_KEY=
