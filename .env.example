# ============================================================
#  Telegram group management SaaS platform - env example
#  Copy to .env then edit:  cp .env.example .env
# ============================================================

# ---------- general ----------
NODE_ENV=development

# Public URL of the platform (Telegram webhook needs an HTTPS public URL).
# For local dev expose via ngrok/cloudflared: https://xxxx.ngrok-free.app
PUBLIC_URL=http://localhost

# ---------- PostgreSQL ----------
POSTGRES_USER=tgadmin
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=tg_saas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tgadmin:change_me_postgres@postgres:5432/tg_saas?schema=public

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---------- backend API ----------
API_PORT=4000
JWT_SECRET=change_me_jwt_secret_please_use_long_random_string
# Prefer shorter lifetimes in production (e.g. 12h). SSE uses a separate 2-minute ticket.
JWT_EXPIRES_IN=12h
TELEGRAM_WEBHOOK_SECRET=change_me_webhook_secret
# Required in production: comma-separated browser origins allowed to call the API.
# Example: https://admin.example.com,https://www.example.com
CORS_ORIGIN=http://localhost

# ---------- platform bot (auto-connects on startup) ----------
# Paste the token from @BotFather here. Leave empty to disable the default bot
# (you can still add bots from the dashboard).
BOT_TOKEN=
# Optional, informational (e.g. my_group_bot). Used as the bot display name.
BOT_USERNAME=
# Public HTTPS base URL for Telegram webhooks, e.g. https://xxxx.ngrok-free.app
# The platform appends /webhook/<botId> automatically.
# If left EMPTY, the bot connects via long polling (works locally without HTTPS).
WEBHOOK_URL=

# ---------- frontend ----------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost/api

# ---------- nginx ----------
# Host port for the bundled nginx. Set to 8080 when an external panel (e.g. BaoTa)
# already owns port 80 and reverse-proxies to this.
NGINX_HTTP_PORT=80

# ---------- Listener Center (MTProto / Telethon) ----------
# Shared secret between the API and the listener control HTTP API.
LISTENER_TOKEN=change_me_listener_token
# Internal URL the API uses to reach the listener container.
LISTENER_URL=http://listener:8100
LISTENER_PORT=8100
# AES key used to encrypt secrets at rest (Telegram API Hash). MUST be identical
# for the api and listener services. Use a long random string.
ENCRYPTION_KEY=change_me_encryption_key_use_long_random_string

# ---------- third-party verification (placeholders for now) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---------- AI risk control (placeholder) ----------
AI_RISK_PROVIDER=stub
AI_RISK_API_KEY=

# ---------- OCR / 截图识别（图片查重） ----------
# provider: tesseract (free, local) | ocrspace (paid cloud, more accurate)
OCR_PROVIDER=ocrspace
# OCR.space account credentials (https://ocr.space/ocrapi)
OCRSPACE_USER_ID=
OCRSPACE_API_KEY=
# OCR languages, e.g. eng or eng+chi_sim
OCR_LANG=eng
